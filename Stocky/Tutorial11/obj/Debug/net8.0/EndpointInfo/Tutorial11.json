      "JoinHouseholdDto": {
        "type": "object",
        "properties": {
          "inviteCode": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "Product": {
        "required": [
          "category",
          "name"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "category": {
            "minLength": 1,
            "type": "string"
          },
          "measure": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "PurchaseCreateDto": {
        "required": [
          "purchaseDate",
          "supermarketName"
        ],
        "type": "object",
        "properties": {
          "supermarketName": {
            "minLength": 1,
            "type": "string"
          },
          "purchaseDate": {
            "type": "string",
            "format": "date-time"
          },
          "totalDiscount": {
            "type": "number",
            "format": "double"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PurchaseItemDto"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "PurchaseItemDto": {
        "required": [
          "productName",
          "quantity",
          "unitPrice"
        ],
        "type": "object",
        "properties": {
          "productName": {
            "minLength": 1,
            "type": "string"
          },
          "quantity": {
            "type": "number",
            "format": "double"
          },
          "unitPrice": {
            "type": "number",
            "format": "double"
          },
          "minAlertThreshold": {
            "type": "number",
            "format": "double"
          },
          "expirationDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "daysToAlertBeforeExpiration": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "nullable": true
          },
          "newPassword": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "StockDirectAddDto": {
        "required": [
          "productName",
          "quantity"
        ],
        "type": "object",
        "properties": {
          "productName": {
            "minLength": 1,
            "type": "string"
          },
          "quantity": {
            "type": "number",
            "format": "double"
          },
          "minAlertThreshold": {
            "type": "number",
            "format": "double"
          },
          "expirationDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "daysToAlertBeforeExpiration": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "StockExpirationUpdateDto": {
        "type": "object",
        "properties": {
          "expirationDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "daysToAlertBeforeExpiration": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "StockQuantityUpdateDto": {
        "type": "object",
        "properties": {

            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "StockThresholdUpdateDto": {
        "required": [
          "newThreshold"
        ],
        "type": "object",
        "properties": {
          "newThreshold": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "Supermarket": {
